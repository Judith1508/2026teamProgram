package org.firstinspires.ftc.teamcode;

import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.hardware.rev.RevHubOrientationOnRobot;
import com.qualcomm.robotcore.hardware.IMU;
import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;

@TeleOp(name = "ProgramacionPrueba")
public class ProgramacionPrueba extends LinearOpMode {

    // ==========================
    // MOTORES
    // ==========================

    private DcMotor der;
    private DcMotor izq;
    private DcMotor banda;
    private DcMotor recolectora;
    private DcMotor lanzadoraArriba;
    private DcMotor lanzadoraAbajo;
    private DcMotor escalar;

    // ==========================
    // IMU
    // ==========================

    private IMU imu;

    // ==========================
    // ESTADOS DE MECANISMOS
    // ==========================

    private boolean recolectoraAdelante = false;
    private boolean recolectoraReversa = false;

    private boolean bandaAdelante = false;
    private boolean bandaReversa = false;

    private boolean lanzadoraArribaON = false;

    // ==========================
    // BOTONES ANTERIORES
    // ==========================

    private boolean xAnterior = false;
    private boolean bAnterior = false;

    private boolean aAnterior = false;
    private boolean yAnterior = false;

    private boolean rbAnterior = false;

    // ==========================
    // PID PARA MANTENER RUMBO
    // ==========================

    private double objetivoYaw = 0;

    // Ganancias PID
    private double kP = 0.025;
    private double kI = 0.0;
    private double kD = 0.002;

    private double errorAnterior = 0;
    private double integral = 0;

    // ==========================
    // VELOCIDAD MÁXIMA DE CORRECCIÓN
    // ==========================

    private static final double MAX_CORRECCION = 0.25;

    @Override
    public void runOpMode() {

        // ==========================
        // HARDWARE
        // ==========================

        der = hardwareMap.get(DcMotor.class, "der");
        izq = hardwareMap.get(DcMotor.class, "izq");

        banda = hardwareMap.get(DcMotor.class, "banda");
        recolectora = hardwareMap.get(DcMotor.class, "recolectora");

        lanzadoraArriba =
                hardwareMap.get(DcMotor.class, "lanzadoraArriba");

        lanzadoraAbajo =
                hardwareMap.get(DcMotor.class, "lanzadoraAbajo");

        escalar =
                hardwareMap.get(DcMotor.class, "escalar");

        // ==========================
        // IMU
        // ==========================

        imu = hardwareMap.get(IMU.class, "imu");

        IMU.Parameters parametrosIMU = new IMU.Parameters(
                new RevHubOrientationOnRobot(
                        RevHubOrientationOnRobot.LogoFacingDirection.UP,
                        RevHubOrientationOnRobot.UsbFacingDirection.FORWARD
                )
        );

        imu.initialize(parametrosIMU);

        // ==========================
        // DIRECCIONES
        // ==========================

        der.setDirection(DcMotor.Direction.REVERSE);
        izq.setDirection(DcMotor.Direction.FORWARD);

        banda.setDirection(DcMotor.Direction.FORWARD);
        recolectora.setDirection(DcMotor.Direction.FORWARD);

        lanzadoraArriba.setDirection(DcMotor.Direction.FORWARD);
        lanzadoraAbajo.setDirection(DcMotor.Direction.FORWARD);

        escalar.setDirection(DcMotor.Direction.FORWARD);

        // ==========================
        // BRAKE
        // ==========================

        der.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        izq.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        banda.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        recolectora.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        lanzadoraArriba.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
        );

        lanzadoraAbajo.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
        );

        escalar.setZeroPowerBehavior(
                DcMotor.ZeroPowerBehavior.BRAKE
        );

        telemetry.addLine("===== ROBOT LISTO =====");
        telemetry.addLine("IMU + PID ACTIVOS");
        telemetry.addLine("Presiona START");
        telemetry.update();

        waitForStart();

        // ==========================
        // REINICIAR YAW
        // ==========================

        imu.resetYaw();

        objetivoYaw = 0;
        errorAnterior = 0;
        integral = 0;

        // ==========================
        // LOOP PRINCIPAL
        // ==========================

        while (opModeIsActive()) {

            // ==================================================
            // DRIVETRAIN
            // ==================================================

            double adelante = -gamepad1.left_stick_y;
            double giro = gamepad1.right_stick_x;

            /*
             * Si el conductor está girando manualmente,
             * el PID no intenta corregir el giro.
             *
             * Cuando el joystick derecho vuelve al centro,
             * el robot intenta mantener el rumbo actual.
             */

            double yawActual = imu.getRobotYawPitchRollAngles()
                    .getYaw(AngleUnit.DEGREES);

            if (Math.abs(giro) > 0.05) {

                // El conductor está girando.
                // Actualizamos el objetivo al ángulo actual.
                objetivoYaw = yawActual;

                errorAnterior = 0;
                integral = 0;

            } else if (Math.abs(adelante) > 0.05) {

                // El robot está avanzando o retrocediendo.
                // PID intenta mantener el rumbo.

                double error = normalizarAngulo(
                        objetivoYaw - yawActual
                );

                integral += error;

                // Evita que la integral crezca demasiado.
                integral = limitar(integral, -100, 100);

                double derivada = error - errorAnterior;

                double correccion =
                        (kP * error) +
                        (kI * integral) +
                        (kD * derivada);

                correccion = limitar(
                        correccion,
                        -MAX_CORRECCION,
                        MAX_CORRECCION
                );

                errorAnterior = error;

                // Aplicamos la corrección al drivetrain.
                giro = correccion;

            } else {

                // Robot detenido.
                objetivoYaw = yawActual;

                errorAnterior = 0;
                integral = 0;
            }

            // ==========================
            // POTENCIA DEL DRIVETRAIN
            // ==========================

            double potenciaIzq = adelante + giro;
            double potenciaDer = adelante - giro;

            potenciaIzq = limitar(potenciaIzq, -1.0, 1.0);
            potenciaDer = limitar(potenciaDer, -1.0, 1.0);

            izq.setPower(potenciaIzq);
            der.setPower(potenciaDer);

            // ==================================================
            // RECOLECTORA
            // ==================================================

            // X = adelante ON/OFF
            if (gamepad1.x && !xAnterior) {

                recolectoraAdelante =
                        !recolectoraAdelante;

                if (recolectoraAdelante) {
                    recolectoraReversa = false;
                }
            }

            // B = reversa ON/OFF
            if (gamepad1.b && !bAnterior) {

                recolectoraReversa =
                        !recolectoraReversa;

                if (recolectoraReversa) {
                    recolectoraAdelante = false;
                }
            }

            xAnterior = gamepad1.x;
            bAnterior = gamepad1.b;

            if (recolectoraAdelante) {

                recolectora.setPower(0.7);

            } else if (recolectoraReversa) {

                recolectora.setPower(-0.7);

            } else {

                recolectora.setPower(0);
            }

            // ==================================================
            // BANDA
            // ==================================================

            // A = adelante ON/OFF
            if (gamepad1.a && !aAnterior) {

                bandaAdelante = !bandaAdelante;

                if (bandaAdelante) {
                    bandaReversa = false;
                }
            }

            // Y = reversa ON/OFF
            if (gamepad1.y && !yAnterior) {

                bandaReversa = !bandaReversa;

                if (bandaReversa) {
                    bandaAdelante = false;
                }
            }

            aAnterior = gamepad1.a;
            yAnterior = gamepad1.y;

            if (bandaAdelante) {

                banda.setPower(1.0);

            } else if (bandaReversa) {

                banda.setPower(-1.0);

            } else {

                banda.setPower(0);
            }

            // ==================================================
            // LANZADORA ARRIBA
            // ==================================================

            // RB = ON/OFF

            if (gamepad1.right_bumper &&
                    !rbAnterior) {

                lanzadoraArribaON =
                        !lanzadoraArribaON;
            }

            rbAnterior =
                    gamepad1.right_bumper;

            if (lanzadoraArribaON) {

                lanzadoraArriba.setPower(1.0);

            } else {

                lanzadoraArriba.setPower(0);
            }

            // ==================================================
            // LANZADORA ABAJO
            // ==================================================

            // LB = reversa
            // LT = adelante

            if (gamepad1.left_bumper) {

                lanzadoraAbajo.setPower(-1.0);

            } else if (gamepad1.left_trigger > 0.1) {

                lanzadoraAbajo.setPower(1.0);

            } else {

                lanzadoraAbajo.setPower(0);
            }

            // ==================================================
            // ESCALADOR
            // ==================================================

            // D-PAD ARRIBA = SUBIR
            // D-PAD ABAJO = BAJAR

            if (gamepad1.dpad_up) {

                escalar.setPower(1.0);

            } else if (gamepad1.dpad_down) {

                escalar.setPower(-1.0);

            } else {

                escalar.setPower(0);
            }

            // ==================================================
            // TELEMETRÍA IMU
            // ==================================================

            double pitch = imu.getRobotYawPitchRollAngles()
                    .getPitch(AngleUnit.DEGREES);

            double roll = imu.getRobotYawPitchRollAngles()
                    .getRoll(AngleUnit.DEGREES);

            // ==================================================
            // TELEMETRÍA
            // ==================================================

            telemetry.addLine("===== ROBOT =====");

            telemetry.addData(
                    "Avance",
                    "%.2f",
                    adelante
            );

            telemetry.addData(
                    "Giro joystick",
                    "%.2f",
                    gamepad1.right_stick_x
            );

            telemetry.addData(
                    "Correccion PID",
                    "%.3f",
                    giro
            );

            telemetry.addData(
                    "Potencia Izq",
                    "%.2f",
                    potenciaIzq
            );

            telemetry.addData(
                    "Potencia Der",
                    "%.2f",
                    potenciaDer
            );

            telemetry.addLine("");

            telemetry.addData(
                    "IMU Yaw",
                    "%.1f°",
                    yawActual
            );

            telemetry.addData(
                    "Yaw objetivo",
                    "%.1f°",
                    objetivoYaw
            );

            telemetry.addData(
                    "PID Error",
                    "%.2f°",
                    normalizarAngulo(
                            objetivoYaw - yawActual
                    )
            );

            telemetry.addData(
                    "IMU Pitch",
                    "%.1f°",
                    pitch
            );

            telemetry.addData(
                    "IMU Roll",
                    "%.1f°",
                    roll
            );

            telemetry.addLine("");

            telemetry.addData(
                    "Recolectora",
                    recolectoraAdelante
                            ? "ADELANTE"
                            : recolectoraReversa
                            ? "REVERSA"
                            : "APAGADA"
            );

            telemetry.addData(
                    "Banda",
                    bandaAdelante
                            ? "ADELANTE"
                            : bandaReversa
                            ? "REVERSA"
                            : "APAGADA"
            );

            telemetry.addData(
                    "Lanzadora Arriba",
                    lanzadoraArribaON
                            ? "ENCENDIDA"
                            : "APAGADA"
            );

            telemetry.addData(
                    "Lanzadora Abajo",
                    gamepad1.left_bumper
                            ? "REVERSA"
                            : gamepad1.left_trigger > 0.1
                            ? "ADELANTE"
                            : "APAGADA"
            );

            telemetry.update();
        }
    }

    // ==================================================
    // LIMITAR VALORES
    // ==================================================

    private double limitar(
            double valor,
            double minimo,
            double maximo) {

        if (valor > maximo) {
            return maximo;
        }

        if (valor < minimo) {
            return minimo;
        }

        return valor;
    }

    // ==================================================
    // NORMALIZAR ÁNGULO
    // ==================================================

    private double normalizarAngulo(double angulo) {

        while (angulo > 180) {
            angulo -= 360;
        }

        while (angulo < -180) {
            angulo += 360;
        }

        return angulo;
    }
}
